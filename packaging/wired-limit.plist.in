<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The GPU wired memory limit's helper (TODO item 51), registered by the
     app through SMAppService and approved by the user. It runs as root at
     boot, to apply the limit it keeps, and when the app asks over XPC. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>@BUNDLE_ID@.wired-limit</string>
	<key>BundleProgram</key>
	<string>Contents/Helpers/wired-limit</string>
	<key>MachServices</key>
	<dict>
		<key>@BUNDLE_ID@.wired-limit</key>
		<true/>
	</dict>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>@BUNDLE_ID@</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Library/Logs/@BUNDLE_ID@.wired-limit.log</string>
</dict>
</plist>
